# make
alias make='gmake -s'
alias sed=gsed
alias ❯=

# HomeBrew
export PATH=$PATH:/opt/homebrew/bin
# Colima
export DOCKER_HOST=unix://$HOME/.colima/default/docker.sock

# Python (pip3)
export PATH=$PATH:$HOME/Library/Python/3.9/bin
# Node (Codex)
export PATH=$PATH:/Applications/Codex.app/Contents/Resources/cua_node/bin
