#!/bin/sh
set -eu

DEFAULT_BRANCH="${DEFAULT_BRANCH:-main}"

_ghn() {
	larges="$(find . -mindepth 1 -type f -size +50M -not -path './.git/*' || true)"
	if [ -n "$larges" ]; then
		.warning 'some files over the capacity limit (>= 50MB)'
		printf '%s\n' "$larges" | nl
		.warning 'use .gitignore or .git/info/exclude before commit'
	fi

	if ! gh auth status >/dev/null 2>&1; then
		.failure 'to get started with GitHub CLI, please run: gh auth login'
		return 1
	fi

	if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
		.debug 'git repository was not found. initializing...'
		git init
		git branch -M "$DEFAULT_BRANCH"
		.success 'git repository was initialized.'
	fi

	current_branch="$(git branch --show-current 2>/dev/null || true)"
	if [ -z "$current_branch" ]; then
		current_branch="$DEFAULT_BRANCH"
		git branch -M "$current_branch" 2>/dev/null || true
	fi

	origin_url="$(git remote get-url origin 2>/dev/null || true)"
	repo_name="$(basename "$PWD")"

	if [ -n "$origin_url" ]; then
		repo_name="$(basename -s .git "$origin_url")"
		.warning "remote already exists: $repo_name"
	else
		repo_name="$(
			.prompt 'Repository Name' "$(basename "$PWD")" "$repo_name"
		)"

		if [ -z "$repo_name" ]; then
			.failure 'repository name is required'
			return 1
		fi

		if gh repo view "$repo_name" >/dev/null 2>&1; then
			.debug "repository already exists on GitHub: $repo_name"

			origin_url="$(gh repo view "$repo_name" --json sshUrl -q .sshUrl)"
			git remote add origin "$origin_url"
			.success "remote origin was added: $origin_url"
		else
			yn="$(
				.prompt "create repository '$repo_name' on github.com?" 'y/N'
			)"

			if [ "$yn" = 'y' ]; then
				visibility='private'
				visibility="$(
					.prompt "visibility 'private' or 'public'" "$visibility" "$visibility"
				)"

				if [ "$visibility" != 'private' ] && [ "$visibility" != 'public' ]; then
					.failure "visibility cannot be $visibility, only private or public"
					return 1
				fi

				gh repo create "$repo_name" \
					"--$visibility" \
					--source=. \
					--remote=origin

				.success "repository was created: $repo_name"
			else
				.warning 'repository creation was skipped'
			fi
		fi
	fi

	commit_message="$(
		.prompt 'Commit message' 'empty = skip commit'
	)"

	if [ -n "$commit_message" ]; then
		git add .

		if ! git diff --cached --quiet; then
			git commit -m "$commit_message"
			.success 'changes were committed.'
		else
			.debug 'no changes to commit.'
		fi
	else
		.debug 'commit was skipped.'
	fi

	if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
		.failure 'no commits exist. enter a commit message before push.'
		return 1
	fi

	if ! git remote get-url origin >/dev/null 2>&1; then
		.failure 'remote origin does not exist. cannot push.'
		return 1
	fi

	yn="$(
		.prompt "push to '$repo_name'?" 'y/N'
	)"

	if [ "$yn" = 'y' ]; then
		git push -u origin "$current_branch"
		.success "pushed to origin/$current_branch."
	else
		.warning 'push was skipped.'
	fi
}

_ghn "$@"
